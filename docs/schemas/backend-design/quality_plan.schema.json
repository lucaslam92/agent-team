{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-dev-agent.local/schemas/backend-design/quality_plan.schema.json",
  "title": "Backend Quality Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "idempotency_strategy",
    "consistency_strategy",
    "concurrency_control",
    "permission_model",
    "observability",
    "rollout_plan",
    "rollback_plan"
  ],
  "properties": {
    "feature_id": {
      "type": "string"
    },
    "idempotency_strategy": {
      "$ref": "#/$defs/strategy"
    },
    "consistency_strategy": {
      "$ref": "#/$defs/strategy"
    },
    "concurrency_control": {
      "$ref": "#/$defs/strategy"
    },
    "permission_model": {
      "$ref": "#/$defs/strategy"
    },
    "observability": {
      "$ref": "#/$defs/strategy"
    },
    "rollout_plan": {
      "$ref": "#/$defs/strategy"
    },
    "rollback_plan": {
      "$ref": "#/$defs/strategy"
    }
  },
  "$defs": {
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
