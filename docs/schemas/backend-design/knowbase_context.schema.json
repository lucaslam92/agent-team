{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-dev-agent.local/schemas/backend-design/knowbase_context.schema.json",
  "title": "Backend Knowbase Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "business_context",
    "architecture_constraints",
    "backend_rules",
    "api_rules",
    "data_rules",
    "testing_rules",
    "technical_stack",
    "anti_patterns",
    "resolved_references",
    "unresolved_gaps",
    "extraction_status"
  ],
  "properties": {
    "business_context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextNote"
      }
    },
    "architecture_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextNote"
      }
    },
    "backend_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextNote"
      }
    },
    "api_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextNote"
      }
    },
    "data_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextNote"
      }
    },
    "testing_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextNote"
      }
    },
    "technical_stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "framework",
        "storage",
        "cache",
        "mq"
      ],
      "properties": {
        "language": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "framework": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "storage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cache": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mq": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "anti_patterns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contextNote"
      }
    },
    "resolved_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "unresolved_gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "extraction_status": {
      "type": "string",
      "enum": [
        "ready",
        "degraded",
        "blocked"
      ]
    }
  },
  "$defs": {
    "contextNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "repo-local",
            "platform",
            "global"
          ]
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_id",
        "path"
      ],
      "properties": {
        "ref_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "summary",
        "severity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "recommended_action": {
          "type": "string"
        }
      }
    }
  }
}
