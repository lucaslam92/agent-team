{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-dev-agent.local/schemas/frontend-design/frontend_scope.schema.json",
  "title": "Frontend Scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feature_id",
    "frontend_responsibilities",
    "backend_responsibilities",
    "shared_contracts",
    "out_of_scope",
    "assumptions"
  ],
  "properties": {
    "feature_id": { "type": "string" },
    "platform": { "type": "string" },
    "frontend_responsibilities": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "backend_responsibilities": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "shared_contracts": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "out_of_scope": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "open_issues": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary"],
      "properties": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "acceptance_refs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
