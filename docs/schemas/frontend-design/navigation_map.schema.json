{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-dev-agent.local/schemas/frontend-design/navigation_map.schema.json",
  "title": "Frontend Navigation Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "routes", "transitions", "guards", "params", "deeplink_rules"],
  "properties": {
    "feature_id": { "type": "string" },
    "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
    "guards": { "type": "array", "items": { "type": "string" } },
    "params": { "type": "array", "items": { "type": "string" } },
    "deeplink_rules": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "page_id": { "type": "string" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "trigger"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "trigger": { "type": "string" }
      }
    }
  }
}
