{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-dev-agent.local/schemas/frontend-design/quality_plan.schema.json",
  "title": "Frontend Quality Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature_id", "accessibility", "performance_budget", "state_consistency", "error_handling", "observability", "rollout_plan", "fallback_plan"],
  "properties": {
    "feature_id": { "type": "string" },
    "accessibility": { "$ref": "#/$defs/strategy" },
    "performance_budget": { "$ref": "#/$defs/strategy" },
    "state_consistency": { "$ref": "#/$defs/strategy" },
    "error_handling": { "$ref": "#/$defs/strategy" },
    "observability": { "$ref": "#/$defs/strategy" },
    "rollout_plan": { "$ref": "#/$defs/strategy" },
    "fallback_plan": { "$ref": "#/$defs/strategy" }
  },
  "$defs": {
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": { "type": "string" },
        "actions": { "type": "array", "items": { "type": "string" } },
        "acceptance_refs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
