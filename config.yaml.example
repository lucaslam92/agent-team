# QQ Codex Bridge — example configuration
# Copy to config.yaml and fill in your credentials.
# All values can also be set via environment variables (see config.py).

bot:
  app_id: "YOUR_QQ_APP_ID"          # QQ 开放平台 AppID（数字字符串）
  app_secret: "YOUR_QQ_APP_SECRET"  # QQ 开放平台 AppSecret
  # Set to true to use sandbox API endpoints
  sandbox: false

gateway:
  # Seconds before a codex exec call is force-killed
  exec_timeout: 120

codex:
  # Path to the codex binary (default: found via $PATH)
  binary: "codex"
  # Default working directory for new sessions
  default_workdir: "~"
  # Max characters per QQ message (QQ group limit ~2000)
  reply_chunk_size: 1800
  # Max retry attempts for reply delivery
  reply_max_retries: 3
